# Postgres (Neon pooled URL in production; `pnpm db:local` gives postgres://postgres:postgres@127.0.0.1:5433/postgres)
DATABASE_URL=
# Optional direct (non-pooled) URL used by migrations; Neon's Vercel integration sets it
DATABASE_URL_UNPOOLED=
# On Vercel, makes the build use the pnpm version pinned in package.json
ENABLE_EXPERIMENTAL_COREPACK=1
# Public URL of this app, e.g. https://paysandbox.vercel.app
APP_URL=
# Better Auth
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# GitHub OAuth app (callback: <APP_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub numeric user IDs that are always allowed to sign up (admins)
ADMIN_GITHUB_IDS=
# Where "Request access" and "Report abuse" links go (falls back to the repo's GitHub issues)
ABUSE_EMAIL=
# Never set these on Vercel: test-only login and the fake E2E store
# E2E_AUTH_BYPASS=1
